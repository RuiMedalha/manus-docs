# Domínio com registo A já apontado para o IP público da VPS.
DOMAIN=app.exemplo.pt

# Base de dados local na VPS.
MYSQL_PASSWORD=altere-para-uma-password-longa-e-unica
MYSQL_ROOT_PASSWORD=altere-para-outra-password-longa-e-unica

# Estes valores devem ser fornecidos pelo seu fornecedor de autenticação e armazenamento.
# Não copie segredos do ambiente Manus para este ficheiro.
JWT_SECRET=gere-um-segredo-longo-e-unico
OAUTH_SERVER_URL=https://oauth.seu-fornecedor.example
VITE_APP_ID=substituir
VITE_OAUTH_PORTAL_URL=https://login.seu-fornecedor.example
BUILT_IN_FORGE_API_URL=substituir-por-adaptador-s3-externo
BUILT_IN_FORGE_API_KEY=substituir-por-segredo-do-adaptador
