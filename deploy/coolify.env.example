# Runtime-only variables for the DocuFlux application in Coolify.
# Do not commit real values and never add GEMINI_API_KEY to frontend variables.

NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://docuflux:CHANGE_ME@docuflux-mysql:3306/docuflux
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
APP_BASE_URL=https://app.example.com

# Private MinIO network endpoint for upload; public HTTPS endpoint for signed downloads.
S3_ENDPOINT=http://docuflux-minio:9000
S3_PUBLIC_ENDPOINT=https://storage.example.com
S3_REGION=us-east-1
S3_BUCKET=docuflux-production
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# Gemini remains disabled until a test key and approved documents are available.
# gemini-3.1-flash-lite is the current cost-efficient multimodal default.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_DOCUMENT_BYTES=10485760
GEMINI_DAILY_DOCUMENT_LIMIT=50

# TOConline: definir apenas nos Secrets da aplicação Coolify depois de obter os dados em Empresa > Configurações > Dados API.
# Nunca expor estes valores em VITE_*, campos de formulário, registos de auditoria ou payloads enviados ao navegador.
# O envio permanece desligado até validar a ligação, o URL de retorno HTTPS e a aprovação profissional por documento.
TOCONLINE_OAUTH_CLIENT_ID=
TOCONLINE_OAUTH_CLIENT_SECRET=
TOCONLINE_OAUTH_URL=
TOCONLINE_API_URL=
TOCONLINE_OAUTH_REDIRECT_URL=
